plugins=(docker git ruby zsh-autosuggestions)

fpath=($HOME/.zsh/completions $fpath)
autoload -Uz compinit
compinit

ZSH_THEME="ohmymatheus"

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

if [[ -z "$__MISE_DIFF" ]]; then
  eval "$(mise activate zsh)"
fi

source ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
export ZSH=$HOME"/.oh-my-zsh"
source $ZSH/oh-my-zsh.sh

export LANG=en_US.UTF-8
export EDITOR=nvim
export GPG_TTY=$(tty)
export LIGHT_THEME={{ .themes.light  }}
export DARK_THEME={{ .themes.dark }}

export OBSIDIAN_VAULT_PATH={{ .notes.vault.path }}
export PI_CODING_AGENT_DIR={{ .pi.path }}

[ -f "$HOME/z/z.sh" ] && . "$HOME/z/z.sh"
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
[ -f "$HOME/.direnv" ] && . "$HOME/.direnv"
[ -f "$HOME/.env" ] && . "$HOME/.env"
[ -f "$HOME/.fzf.zsh" ] && . "$HOME/.fzf.zsh"
[ -f "$HOME/.ghcup/env" ] && . "$HOME/.ghcup/env"
[ -f "$HOME/.alias" ] && . "$HOME/.alias"
[ -f "$HOME/.scripts" ] && . "$HOME/.scripts"
[ -f "$HOME/.tokens" ] && . "$HOME/.tokens"
{{- if eq .chezmoi.os "linux" }}
[ -f "$HOME/.wsl" ] && . "$HOME/.wsl"
[ -f "$HOME/.wslpaths" ] && . "$HOME/.wslpaths"
[[ ! -r '/home/matheus/.opam/opam-init/init.zsh' ]] || source '/home/matheus/.opam/opam-init/init.zsh' > /dev/null 2> /dev/null
{{- end }}

path_prepend "$HOME/.local/bin"
path_prepend "$HOME/.bin"
path_prepend "/usr/local/bin"
path_prepend "/usr/bin"
path_prepend "/bin"
path_prepend "$HOME/.emacs.d/bin"
path_prepend "$HOME/.cargo/bin"
path_prepend "$HOME/.luarocks/bin"
path_prepend "$HOME/scripts"

{{- if eq .chezmoi.os "linux" }}
export QML2_IMPORT_PATH="$HOME/.config/quickshell/plugin/build/qml:${QML2_IMPORT_PATH:-}"
export FLYCTL_INSTALL="/home/matheus/.fly"
export PNPM_HOME="/home/matheus/.local/share/pnpm"
path_prepend "$PNPM_HOME"
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
path_prepend "/opt/homebrew/bin:$PATH"
export TERM="xterm-256color"
{{- end }}

if [[ -z "${TMUX}" ]] then;
  tmux attach || exec tmux new-session -s Personal;
fi

bindkey '^Z' autosuggest-accept
